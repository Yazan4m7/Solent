PS_APP_CURRENCY_CODE=ILS
PS_APP_CURRENCY_DISPLAY=ILS
PS_APP_CURRENCY_UNIT_AR=شيكل
PS_APP_CURRENCY_NAME_AR=شيكل

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
