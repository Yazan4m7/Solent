{
    "private": true,
    "scripts": {
        "dev": "npm run development",
        "development": "mix",
        "watch": "mix watch",
        "watch-poll": "mix watch -- --watch-options-poll=1000",
        "hot": "mix watch --hot",
        "prod": "npm run production",
        "production": "mix --production",
        "test:frontend": "node --test tests/js/frontend-contracts.test.mjs",
        "test:frontend:hardening": "node --test tests/js/frontend-hardening.test.mjs",
        "test:http": "node --test tests/http/http-smoke.test.mjs",
        "test:browser": "node --test tests/browser/browser-smoke.test.mjs",
        "test:nonphp": "npm run test:frontend && npm run test:http && npm run test:browser",
        "test:modules": "node --test tests/js/modules-frontend-contracts.test.mjs"
    },
    "devDependencies": {
        "axios": "^0.21",
        "bootstrap": "^4.6.0",
        "browser-sync": "^3.0.4",
        "browser-sync-webpack-plugin": "^2.3.0",
        "jquery": "^3.6",
        "laravel-mix": "^6.0.6",
        "lodash": "^4.17.19",
        "popper.js": "^1.16.1",
        "postcss": "^8.1.14",
        "resolve-url-loader": "^3.1.2",
        "sass": "^1.32.11",
        "sass-loader": "^11.0.1",
        "vue": "^2.6.12",
        "vue-loader": "^15.9.8",
        "vue-template-compiler": "^2.6.12"
    },
    "dependencies": {
        "dotenv": "^16.5.0",
        "node-fetch": "^3.3.2"
    }
}
